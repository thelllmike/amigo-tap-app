{
  "expo": {
    "name": "AmigoTap",
    "slug": "amigotap-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amigotap",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "com.amigotap.owner",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:amigotap.com",
        "appclips:amigotap.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.amigotap.owner",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-audio",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#C8FF00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AmigoTap uses your photos for your page's logo and menu pictures."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "AmigoTap uses NFC to read AmigoTap cards and write your page link to a tag.",
          "includeNdefEntitlement": true
        }
      ],
      [
        "react-native-app-clip",
        {
          "name": "AmigoTap Clip",
          "deploymentTarget": "16.4",
          "excludedPackages": [
            "expo-dev-client",
            "expo-dev-launcher",
            "expo-dev-menu",
            "react-native-nfc-manager",
            "expo-image-picker",
            "expo-audio",
            "expo-notifications"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
