<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.NFC" />
  <!-- Optional: phones without HCE can still install the app; sharing falls back to QR. -->
  <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

  <application>
    <!--
      Starts disabled. AmigoHceModule enables it only while the owner is on the
      "Tap to share" screen, so the phone never answers NFC readers in a pocket.
    -->
    <service
      android:name="expo.modules.amigohce.AmigoHceService"
      android:enabled="false"
      android:exported="true"
      android:permission="android.permission.BIND_NFC_SERVICE">
      <intent-filter>
        <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <meta-data
        android:name="android.nfc.cardemulation.host_apdu_service"
        android:resource="@xml/amigo_hce_aid_list" />
    </service>
  </application>
</manifest>
